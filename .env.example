TENANT_DATABASE_URL="mysql://root:password@127.0.0.1:3306/{tenant_db_name}"
GLOBAL_DB_URL="mysql://root:password@127.0.0.1:3306/global"

NODE_ENV=development
PORT=8080
PUSHY_SECRET_API_KEY="your_pushy_secret_key"

# Production DB URLs — used by `npm run upgrade_db_prod` / `npm run backup_db_prod`
PROD_GLOBAL_DB_URL="mysql://user:password@prod-host:3306/global?sslaccept=strict"
PROD_TENANT_DATABASE_URL="mysql://user:password@prod-host:3306/{tenant_db_name}?sslaccept=strict"

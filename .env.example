TENANT_DATABASE_URL="mysql://root:password@127.0.0.1:3306/{tenant_db_name}"
GLOBAL_DB_URL="mysql://root:password@127.0.0.1:3306/global"

NODE_ENV=development
PORT=8080
# Legacy Pushy sender — only for installs that predate the FCM move; unset to stop Pushy sends
PUSHY_SECRET_API_KEY="your_pushy_secret_key"
# Firebase Cloud Messaging: service-account JSON (Firebase console → Project settings →
# Service accounts → Generate new private key), raw or base64-encoded. Unset = FCM sends skipped.
FIREBASE_SERVICE_ACCOUNT=""

# Production DB URLs — used by `npm run upgrade_db_prod` / `npm run backup_db_prod`
PROD_GLOBAL_DB_URL="mysql://user:password@prod-host:3306/global?sslaccept=strict"
PROD_TENANT_DATABASE_URL="mysql://user:password@prod-host:3306/{tenant_db_name}?sslaccept=strict"

# Cloudflare R2 — online catalogue image storage (see docs/future/ONLINE_CATALOGUE.md)
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_BUCKET="bayaryuk-catalogue"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_PUBLIC_BASE_URL="https://images.bayaryuk.net"

# NEW prod — Azure free-tier rerun on a separate account (DB_MIGRATION_2026.md).
# Fill in at Phase 1, once the new MySQL Flexible Server is provisioned.
# Keep the same {tenant_db_name} placeholder as TENANT_DATABASE_URL.
NEWPROD_GLOBAL_DB_URL="mysql://<user>:<password>@<newserver>.mysql.database.azure.com:3306/global?sslaccept=strict"
NEWPROD_TENANT_DATABASE_URL="mysql://<user>:<password>@<newserver>.mysql.database.azure.com:3306/{tenant_db_name}?sslaccept=strict"
